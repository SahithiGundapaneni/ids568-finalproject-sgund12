{
  "title": "LLM Inference API - Production Dashboard",
  "description": "IDS 568 Final Project - sgund12 - Monitoring dashboard for LLM inference service",
  "schemaVersion": 36,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Request Latency P50 / P99",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(llm_request_latency_seconds_bucket[1m]))",
          "legendFormat": "P50 Latency"
        },
        {
          "expr": "histogram_quantile(0.99, rate(llm_request_latency_seconds_bucket[1m]))",
          "legendFormat": "P99 Latency"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1.0 },
              { "color": "red",    "value": 2.0 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Request Throughput (req/min)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "rate(llm_requests_total[1m]) * 60",
          "legendFormat": "Requests/min"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqpm" }
      }
    },
    {
      "id": 3,
      "title": "Error Rate (%)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "llm_error_rate_1min * 100",
          "legendFormat": "Error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 20,
          "thresholds": {
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 3 },
              { "color": "red",    "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Input Drift Score",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 8 },
      "targets": [
        {
          "expr": "llm_input_drift_score",
          "legendFormat": "Drift Score"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "steps": [
              { "color": "green",  "value": 0 },
              { "color": "yellow", "value": 0.3 },
              { "color": "red",    "value": 0.45 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Active Requests",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "llm_active_requests",
          "legendFormat": "Active"
        }
      ]
    },
    {
      "id": 6,
      "title": "Response Token Distribution",
      "type": "histogram",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 8 },
      "targets": [
        {
          "expr": "rate(llm_response_tokens_bucket[5m])",
          "legendFormat": "Tokens"
        }
      ]
    }
  ]
}
